{
  "format": "ada.ui",
  "schemaVersion": 1,
  "root": {
    "id": "Result",
    "type": "VStack",
    "arguments": {
      "spacing": {
        "value": 16
      }
    },
    "children": [
      {
        "id": "Result-title",
        "type": "Text",
        "arguments": {
          "text": {
            "value": "ALL STARS FOUND"
          }
        },
        "children": [],
        "modifiers": [
          {
            "id": "Result-title-font",
            "type": "fontSize",
            "arguments": {
              "value": {
                "value": 32
              }
            }
          },
          {
            "id": "Result-title-color",
            "type": "foregroundColor",
            "arguments": {
              "color": {
                "value": "#203247ff"
              }
            }
          }
        ]
      },
      {
        "id": "Result-subtitle",
        "type": "Text",
        "arguments": {
          "text": {
            "value": "Five stars. One great adventure."
          }
        },
        "children": [],
        "modifiers": [
          {
            "id": "Result-subtitle-font",
            "type": "fontSize",
            "arguments": {
              "value": {
                "value": 16
              }
            }
          },
          {
            "id": "Result-subtitle-color",
            "type": "foregroundColor",
            "arguments": {
              "color": {
                "value": "#203247ff"
              }
            }
          }
        ]
      },
      {
        "id": "reward",
        "type": "Image",
        "arguments": {
          "path": {
            "value": "../Textures/star.png"
          }
        },
        "children": [],
        "modifiers": [
          {
            "id": "reward-size",
            "type": "frame",
            "arguments": {
              "width": {
                "value": 80
              },
              "height": {
                "value": 80
              }
            }
          }
        ]
      },
      {
        "id": "result-score",
        "type": "Text",
        "arguments": {
          "text": {
            "binding": "progress"
          }
        },
        "children": [],
        "modifiers": [
          {
            "id": "result-score-font",
            "type": "fontSize",
            "arguments": {
              "value": {
                "value": 18
              }
            }
          },
          {
            "id": "result-score-color",
